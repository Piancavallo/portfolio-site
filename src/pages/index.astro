---
import BioLayout from '@layouts/BioLayout.astro';
import BioPortrait from '@components/home/BioPortrait.astro';
import StorySentence from '@components/home/StorySentence.astro';
import { homeStory } from '@data/homeStory';

const satelliteGlob = import.meta.glob<{ default: { src: string } }>(
  '/src/images/satellite effects/*.{png,PNG,jpg,jpeg,webp}',
  { eager: true },
);
const satelliteSrcs = Object.values(satelliteGlob).map((mod) => mod.default.src);
---

<BioLayout title="Conner Myers" description="Conner Myers — personal homepage">
  <div class="bio-home">
    <div class="bio-home__content">
      <h1 class="bio-home__name">
        <span class="bio-home__name-lead">{homeStory.nameLead}</span>
        {homeStory.name}
      </h1>
      <div class="bio-home__sentences">
        {homeStory.sentences.map((segments) => (
          <StorySentence segments={segments} />
        ))}
      </div>
    </div>
    <BioPortrait src={homeStory.portraitSrc} alt={homeStory.portraitAlt} />
  </div>

  <script
    type="application/json"
    id="story-effect-assets"
    set:html={JSON.stringify({ satelliteSrcs })}
  />

  <script>
    const assetsEl = document.getElementById('story-effect-assets');
    const assets = assetsEl
      ? (JSON.parse(assetsEl.textContent || '{}') as {
          satelliteSrcs?: string[];
        })
      : {};
    const satelliteSrcs = assets.satelliteSrcs ?? [];

    const user = ['conn0', 'myers'].join('');
    const domain = ['gmail', 'com'].join('.');
    const email = `${user}@${domain}`;
    const confettiColors = ['#14b8a6', '#3b82f6', '#ffc013', '#ededed', '#22d3ee'];

    function burstConfetti(x: number, y: number) {
      const count = 28;
      for (let i = 0; i < count; i++) {
        const piece = document.createElement('span');
        piece.className = 'bio-confetti';
        piece.setAttribute('aria-hidden', 'true');

        const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.6;
        const distance = 48 + Math.random() * 72;
        const dx = Math.cos(angle) * distance;
        const dy = Math.sin(angle) * distance - 20;
        const rot = (Math.random() * 520 - 260).toFixed(0);
        const size = 5 + Math.random() * 5;

        piece.style.left = `${x}px`;
        piece.style.top = `${y}px`;
        piece.style.width = `${size}px`;
        piece.style.height = `${size * (0.5 + Math.random())}px`;
        piece.style.background = confettiColors[i % confettiColors.length];
        piece.style.setProperty('--dx', `${dx.toFixed(1)}px`);
        piece.style.setProperty('--dy', `${dy.toFixed(1)}px`);
        piece.style.setProperty('--rot', `${rot}deg`);
        piece.style.animationDelay = `${(Math.random() * 40).toFixed(0)}ms`;

        document.body.appendChild(piece);
        piece.addEventListener('animationend', () => piece.remove(), { once: true });
      }
    }

    function showCopiedLabel(x: number, y: number) {
      const label = document.createElement('span');
      label.className = 'bio-copied-label';
      label.textContent = 'Copied!';
      label.style.left = `${x}px`;
      label.style.top = `${y - 28}px`;
      document.body.appendChild(label);

      const remove = () => label.remove();
      label.addEventListener('animationend', remove, { once: true });
      window.setTimeout(remove, 2200);
    }

    document.querySelectorAll<HTMLButtonElement>('button.bio-home__email').forEach((el) => {
      el.textContent = email;
      el.setAttribute('aria-label', `Copy email address ${email}`);

      el.addEventListener('click', async (event) => {
        try {
          await navigator.clipboard.writeText(email);
        } catch {
          return;
        }
        burstConfetti(event.clientX, event.clientY);
        showCopiedLabel(event.clientX, event.clientY);
      });
    });

    function prefersReducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    type Edge = 'left' | 'right' | 'top' | 'bottom';

    function pointOnEdge(edge: Edge, margin: number) {
      const w = window.innerWidth;
      const h = window.innerHeight;
      const along = 0.12 + Math.random() * 0.76;
      switch (edge) {
        case 'left':
          return { x: -margin, y: along * h };
        case 'right':
          return { x: w + margin, y: along * h };
        case 'top':
          return { x: along * w, y: -margin };
        case 'bottom':
          return { x: along * w, y: h + margin };
      }
    }

    function randomEdgePair() {
      const edges: Edge[] = ['left', 'right', 'top', 'bottom'];
      const from = edges[Math.floor(Math.random() * edges.length)]!;
      let to = edges[Math.floor(Math.random() * edges.length)]!;
      while (to === from) {
        to = edges[Math.floor(Math.random() * edges.length)]!;
      }
      return { from, to };
    }

    function randomSatellitePath() {
      const { from, to } = randomEdgePair();
      const start = pointOnEdge(from, 90);
      const end = pointOnEdge(to, 120);
      const angle = (Math.atan2(end.y - start.y, end.x - start.x) * 180) / Math.PI;
      return {
        x0: `${start.x}px`,
        y0: `${start.y}px`,
        x1: `${end.x}px`,
        y1: `${end.y}px`,
        rot0: `${angle - 18}deg`,
        rot1: `${angle + 22}deg`,
      };
    }

    function pickSatelliteSrc() {
      if (!satelliteSrcs.length) return '';
      return satelliteSrcs[Math.floor(Math.random() * satelliteSrcs.length)]!;
    }

    function spawnStoryEffect(effect: string) {
      if (prefersReducedMotion()) return;
      if (effect !== 'satellite') return;
      const actor = document.createElement('div');
      actor.className = 'bio-effect-actor bio-effect-actor--satellite';
      actor.setAttribute('aria-hidden', 'true');
      const src = pickSatelliteSrc();
      if (src) actor.style.backgroundImage = `url("${src}")`;
      const path = randomSatellitePath();
      actor.style.setProperty('--sat-x0', path.x0);
      actor.style.setProperty('--sat-y0', path.y0);
      actor.style.setProperty('--sat-x1', path.x1);
      actor.style.setProperty('--sat-y1', path.y1);
      actor.style.setProperty('--sat-rot0', path.rot0);
      actor.style.setProperty('--sat-rot1', path.rot1);
      document.body.appendChild(actor);
      actor.addEventListener('animationend', () => actor.remove(), { once: true });
      window.setTimeout(() => actor.remove(), 6500);
    }

    document.querySelectorAll<HTMLButtonElement>('[data-story-effect]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const effect = btn.dataset.storyEffect;
        if (effect === 'satellite') {
          spawnStoryEffect(effect);
        }
      });
    });
  </script>
</BioLayout>
