---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import BioLayout from '@layouts/BioLayout.astro';
import AlbumGallery from '@components/media/AlbumGallery';
import '@styles/dark-subpage.css';
import '@styles/album-gallery.css';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/images/garden/**/*.{jpg,jpeg,png,webp,gif,avif,JPEG,JPG,PNG,WEBP}',
  { eager: true },
);

const gardenImages = (
  await Promise.all(
    Object.entries(imageModules)
      .sort(([a], [b]) => a.localeCompare(b))
      .map(async ([, mod]) => {
        const meta = mod.default;
        const [thumb, full] = await Promise.all([
          getImage({ src: meta, width: 480, height: 480, fit: 'cover', format: 'webp', quality: 72 }),
          getImage({ src: meta, width: 1600, format: 'webp', quality: 78 }),
        ]);
        return {
          src: thumb.src,
          fullSrc: full.src,
          width: thumb.attributes.width as number | undefined,
          height: thumb.attributes.height as number | undefined,
          alt: 'Garden photo',
        };
      }),
  )
);
---

<BioLayout title="Garden | Conner Myers" description="Organic backyard garden photos.">
  <div class="dark-subpage">
    <h1 class="dark-subpage__title">Garden</h1>
    <p class="dark-subpage__intro">
      Started Spring 2025.
    </p>
    <div class="dark-subpage__content">
      <AlbumGallery
        client:load
        images={gardenImages}
        emptyFolderHint="src/images/garden/"
        variant="default"
      />
    </div>
  </div>
</BioLayout>
