---
import PlacesLayout from '@layouts/PlacesLayout.astro';
import PlacesTimeline from '@components/places/PlacesTimeline.astro';
import AlbumDrawer from '@components/places/AlbumDrawer';
import { getLivedAlbumDrawerItems } from '@data/places';

const albums = getLivedAlbumDrawerItems();
---

<PlacesLayout title="Space and Places | Conner Myers" description="A life in motion — places I've lived.">
  <div class="places-shell">
    <header class="places-shell__header">
      <h1 class="places-shell__title">Space and Places</h1>
    </header>

    <PlacesTimeline />
  </div>

  <AlbumDrawer client:only="react" albums={albums} />
</PlacesLayout>
