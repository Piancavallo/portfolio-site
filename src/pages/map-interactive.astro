---
import BaseLayout from '@layouts/BaseLayout.astro';
import PortfolioMap from '@components/PortfolioMap';
import '../styles/map-embed.css';
---

<BaseLayout title="Interactive Map | Conner Myers" description="An interactive map of the places I've lived and traveled.">
  <div class="home-page design-c">
    <div class="design-c__canopy" aria-hidden="true"></div>
    <div class="design-c__trail" aria-hidden="true"></div>

    <div class="design-c__shell">
      <a href="/map" class="design-c__back"><span class="text-arrow" aria-hidden="true">←</span> back to timeline</a>

      <section class="home-map-row" aria-label="Life map">
        <h1 class="design-c__section-title">Places I've Been</h1>
        <p class="design-c__text">Having grown up in a military family, the timeline of my life is rather sporadic, so I made this interactive map as a means to organize and tell my story through photos. I couldn't have done it without the help of my mom who, over the years, was always telling us to "say cheese!" Looks pretty cool on a map, too.</p>
        <div class="design-c__map-embed-wrap">
          <PortfolioMap client:only="react" expandMode="modal" embedded={true} />
        </div>
      </section>
    </div>
  </div>

  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Inter:wght@400;500;600&family=Nunito:wght@400;600;700&display=swap');

    html, body {
      background: #e8e0d0 !important;
      background-image:
        radial-gradient(ellipse at 20% 0%, rgba(74, 124, 89, 0.12) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 100%, rgba(139, 90, 43, 0.1) 0%, transparent 45%),
        linear-gradient(175deg, #ebe4d4 0%, #ddd4c0 40%, #d4cbb5 100%) !important;
      color: #2c3e2a !important;
      font-family: 'Nunito', 'Segoe UI', sans-serif !important;
    }
    h1, h2, h3, h4 {
      font-family: 'Fraunces', Georgia, serif !important;
      color: #1e3d24 !important;
      letter-spacing: 0.01em !important;
    }
  </style>

  <style>
    .design-c {
      position: relative;
      min-height: 100svh;
      color: #2c3e2a;
    }

    .design-c__canopy {
      position: fixed;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 120% 40% at 50% -10%, rgba(45, 90, 55, 0.18) 0%, transparent 60%),
        radial-gradient(ellipse 80% 30% at 10% 20%, rgba(74, 124, 89, 0.08) 0%, transparent 50%),
        radial-gradient(ellipse 60% 25% at 90% 15%, rgba(74, 124, 89, 0.06) 0%, transparent 45%);
    }

    .design-c__trail {
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.04;
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 5 Q35 20 30 35 Q25 50 30 55' stroke='%232c5a32' fill='none' stroke-width='1.5'/%3E%3C/svg%3E");
      background-size: 80px 80px;
    }

    .design-c__shell {
      position: relative;
      z-index: 1;
      max-width: min(96vw, 1400px);
      margin: 0 auto;
      padding: 2.5rem 1.25rem 2rem;
    }

    .design-c__back {
      display: inline-block;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
      font-weight: 700;
      color: #3d6b47;
      text-decoration: none;
    }

    .design-c__back:hover { color: #8b5a2b; }

    .text-arrow {
      font-size: 1.35em;
      font-weight: 600;
      line-height: 1;
      display: inline-block;
      vertical-align: -0.1em;
    }

    .design-c__section-title {
      margin: 0 0 0.6rem;
      font-family: 'Inter', system-ui, sans-serif !important;
      font-size: clamp(2.75rem, 6.5vw, 4.75rem);
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.05;
      color: #1e3d24;
    }

    .design-c__text {
      margin: 0 0 1.5rem;
      font-family: 'Inter', system-ui, sans-serif;
      font-size: clamp(0.95rem, 1.5vw, 1.125rem);
      line-height: 1.75;
      font-weight: 400;
      color: #3d4f3a;
      max-width: 40rem;
    }

    :global(.design-c__map-place-card) {
      padding: 0.625rem 1rem;
      background: linear-gradient(145deg, #fffcf5 0%, #f5eedc 100%);
      border: 1px solid rgba(74, 103, 65, 0.35);
      border-radius: 14px;
      box-shadow: 0 12px 40px rgba(44, 62, 42, 0.08);
    }

    :global(.design-c__map-place-card__title) {
      margin: 0;
      font-size: 0.875rem;
      font-weight: 700;
      line-height: 1.3;
      color: #1e3d24;
    }

    :global(.design-c__map-place-card__years) {
      margin: 0.15rem 0 0;
      font-size: 0.75rem;
      line-height: 1.35;
      color: #3d4f3a;
    }
  </style>
</BaseLayout>
