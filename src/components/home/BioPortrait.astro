---
interface Props {
  src: string;
  alt: string;
  feetSrc?: string;
}

const { src, alt, feetSrc = '/images/feet1.png' } = Astro.props;
---

<aside class="bio-home__portrait" aria-hidden="true">
  <div class="bio-home__portrait-stack">
    <img class="bio-home__portrait-body" src={src} alt={alt} width="520" height="700" loading="eager" decoding="async" />
    <img class="bio-home__portrait-feet" src={feetSrc} alt="" width="200" height="80" loading="eager" decoding="async" />
  </div>
</aside>
